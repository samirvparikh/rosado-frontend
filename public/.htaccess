# Single-page app fallback: serve index.html for client-side routes such as
# /custom-perfume or /perfumes/royal-oud, so refreshing or opening a deep link
# doesn't 404. Real files (assets, images) are still served directly.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
